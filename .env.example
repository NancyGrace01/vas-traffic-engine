# ── SERVER ──
PORT=3000
NODE_ENV=development
# Public URL of this API — used for click tracking redirect links in push notifications
API_BASE_URL=https://vas-traffic-engine-production.up.railway.app

# ── POSTGRESQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vas_engine
DB_USER=vasadmin
DB_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://vasadmin:your_db_password_here@localhost:5432/vas_engine

# ── REDIS ──
REDIS_URL=redis://localhost:6379

# ── FIREBASE CLOUD MESSAGING (FCM V1) ──
FCM_PROJECT_ID=vaspush
FCM_CLIENT_EMAIL=firebase-adminsdk-fbsvc@vaspush.iam.gserviceaccount.com
# Paste the full private key from the service account JSON (keep the \n escape sequences)
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# VAPID key for web push (used in firebase-messaging-sw.js on content pages)
FCM_VAPID_PUBLIC_KEY=BDmmS_PF7pPEg3QxFNL702eZm4eKyoqqb7yERiiBObxE7VhJRcrp-UTF3DZh7PneVuBuXaS14IN4Eobyn6wwW8g
FCM_SENDER_ID=670683679803

# ── IP CARRIER DETECTION ──
# ip-api.com (free tier: 45 req/min — upgrade to pro before go-live at members.ip-api.com)
IP_API_URL=http://ip-api.com/json
# IP_API_KEY=your_pro_key_here  # uncomment when upgrading to Pro

# ── ADMIN AUTH ──
ADMIN_JWT_SECRET=change_this_to_a_long_random_string_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ── MTN BILLING WEBHOOK ──
MTN_WEBHOOK_SECRET=your_mtn_hmac_secret_here

# ── VASNET OFFER URLS (Premium content pages) ──
# Set these when MTN product IDs are approved
BETTING_VIP_URL=AWAITING_MTN_PRODUCT_ID
HEALTH_PREMIUM_URL=AWAITING_MTN_PRODUCT_ID

# ── PROPELLERADS ──
# PROPELLERADS_API_KEY=your_propellerads_key_here

# ── CLICKADU ──
CLICKADU_ACCOUNT_ID=
CLICKADU_AID=

# ── SENTRY ──
SENTRY_DSN=your_sentry_dsn_here
